{
    "name": "smartlinks/laravel-knet",
    "description": "Zero-dependency KNET payment gateway integration for Laravel",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1"
    },
     "authors": [
        {
            "name": "Srinivas Inumarthi",
            "email": "srinuinumarthi79@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "SmartLInks\\LaravelKnet\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SmartLInks\\LaravelKnet\\KnetServiceProvider"
            ],
            "aliases": {
                "Knet": "SmartLInks\\LaravelKnet\\Facades\\Knet"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
